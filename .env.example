# Numele variabilelor, FĂRĂ valori. Valorile vin din macOS Keychain la setup local
# și din env-ul proiectului Vercel în producție. Nu commita niciodată un .env real.

# PostgREST — acces server-to-server la catalogul public.
# Cheia ANON, nu service_role: tot ce citesc tool-urile e deja public prin RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Secretul HMAC al linkului de checkout pre-populat.
# ACEEAȘI valoare trebuie să existe în proiectul Vercel al site-ului tatuat.ro.
AGENT_CHECKOUT_SECRET=

# Originea magazinului, către care trimite create_checkout.
TATUAT_SITE_URL=https://tatuat.ro

# Hostname-urile acceptate în headerul Host al cererilor MCP (listă statică,
# separată prin virgulă). Allowlist STATICĂ — niciodată derivată din cerere.
MCP_ALLOWED_HOSTS=api.tatuat.ro

# Tokenul de verificare a domeniului dat de portalul OpenAI Apps.
# Endpointul /.well-known/openai-apps-challenge întoarce DOAR această valoare.
OPENAI_APPS_CHALLENGE_TOKEN=
