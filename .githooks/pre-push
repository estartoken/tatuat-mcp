#!/bin/sh
# Rulează testele critice ÎNAINTE ca ceva să plece spre GitHub.
#
# De ce există: GitHub Actions e blocat pe acest cont din facturare — nicio rulare
# nu a reușit vreodată. Fără gardă locală, testele rulează doar când își amintește
# cineva. Hook-ul mută garda pe mașină, unde e gratis.
#
# Activare (o singură dată pe clonă):  git config core.hooksPath .githooks
# Ocolire, când chiar trebuie:         git push --no-verify
#
# Hook-urile pre-push primesc pe stdin: <ref-local> <sha-local> <ref-remote> <sha-remote>

set -e

ZERO='0000000000000000000000000000000000000000'
are_de_verificat=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # Ștergere de ramură (`git push --delete`): nu există cod nou de testat.
  [ "$local_sha" = "$ZERO" ] && continue
  are_de_verificat=1
done

if [ "$are_de_verificat" -eq 0 ]; then
  exit 0
fi

printf '\n  Rulez testele critice înainte de push…\n\n'

if npm run --silent test:critical; then
  printf '\n  ✅ Teste + typecheck OK — push permis.\n\n'
  exit 0
fi

printf '\n'
printf '  ❌ PUSH OPRIT — testele critice au picat.\n\n'
printf '  Repară întâi, sau, dacă știi ce faci:\n'
printf '      git push --no-verify\n\n'
exit 1
